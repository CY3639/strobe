# SERVER ONLY: controls where the Node API listens and what public URL it returns for generated upload links.
# This does not change the client Connected API. Use client/.env or the client UI for that.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=your-secret-key-change-in-production
UPLOADS_DIR=uploads
PUBLIC_BASE_URL=http://localhost:3000
